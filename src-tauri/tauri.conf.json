{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiBOX",
  "version": "0.0.1",
  "identifier": "im.aibox.app",
  "mainBinaryName": "AiBOX",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AiBOX",
        "width": 1080,
        "height": 768,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "icon": ["icons/icon.ico", "icons/icon.icns"]
  }
}
